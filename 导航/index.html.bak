title: 收藏网址
date: 2025-07-16 00:06:37
---

<style>
/* ===================================================
   Purple Nav v5 — 水滴图标 · 居中标题 · 底栏跟随
   =================================================== */

/* Reset */
.pnav *, .pnav *::before, .pnav *::after {
  box-sizing: border-box !important;
}

/* ========== Design Tokens ========== */
.pnav {
  --txt: #1e1b4b;
  --txt-dark: #f0e6ff;
  --txt-hover: #7c3aed;
  --txt-hover-dark: #a78bfa;
  --tdesc: rgba(109,40,217,0.55);
  --tdesc-dark: rgba(216,180,254,0.55);
  --toc-bg: rgba(25,20,42,0.55);
  --toc-bg-dark: rgba(15,10,25,0.70);
  max-width: 100%;
  overflow-x: clip;
  position: relative;
  font-family: system-ui, -apple-system, sans-serif;
}
[data-theme="dark"] .pnav {
  --txt: var(--txt-dark);
  --txt-hover: var(--txt-hover-dark);
  --tdesc: var(--tdesc-dark);
}

/* ========== Background ========== */
.pnav::before {
  content: '';
  position: absolute; inset: -30px; z-index: 0;
  pointer-events: none;
  background:
    radial-gradient(360px at 20% 25%, rgba(168,85,247,0.07), transparent 65%),
    radial-gradient(280px at 80% 70%, rgba(192,132,252,0.05), transparent 65%);
}
.pnav > * { position: relative; z-index: 1; }

/* ===================================================
   Category Header — 纯文字分类名
   =================================================== */
.psect { margin-bottom: 18px; }
.psect:last-child { margin-bottom: 0; }

.phead {
  margin: 0 0 8px 0 !important;
  padding: 0 0 6px 0 !important;
  border-bottom: 1.5px solid rgba(139,92,246,0.06) !important;
  scroll-margin-top: 100px;
}
.ptitle {
  margin: 0 !important; padding: 0 !important;
  font-size: 16px !important; font-weight: 700 !important;
  color: var(--txt) !important;
  letter-spacing: -0.01em;
  line-height: 1.3 !important;
  border: none !important;
}

/* ===================================================
   Grid
   =================================================== */
.pgrid {
  display: grid !important;
  grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)) !important;
  gap: 10px !important;
  min-width: 0;
  max-width: 100%;
}

/* ===================================================
   Tile — 极简线条 · 无背景 · 描述从左滑入
   =================================================== */
.ptile {
  display: flex !important;
  flex-direction: row !important;
  align-items: center !important;
  gap: 8px;
  height: 56px !important;
  padding: 8px 12px !important;
  border-radius: 0 !important;
  background: transparent !important;
  border: none !important;
  position: relative !important;
  border-bottom: 1px solid rgba(139,92,246,0.06) !important;
  box-shadow: none !important;
  text-decoration: none !important;
  color: inherit !important;
  transition: none !important;
  animation: pfade 0.35s ease-out both;
}
/* ========== Tile Hover — 从左到右发光下划线 ========== */
.ptile::after {
  content: '';
  position: absolute !important;
  bottom: -1px;
  left: 0;
  width: 0;
  height: 1.5px;
  background: linear-gradient(90deg, #7c3aed, #c084fc) !important;
  box-shadow: 0 0 8px rgba(124,58,237,0.5), 0 0 20px rgba(124,58,237,0.2) !important;
  transition: width 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  pointer-events: none;
  border-radius: 1px;
}
.ptile:hover::after {
  width: 100%;
}
@keyframes pfade {
  from { opacity: 0; transform: translateY(6px); }
  to   { opacity: 1; transform: translateY(0); }
}

/* ========== Icon — 极简线条 ========== */
.pico {
  width: 28px;
  height: 28px;
  border-radius: 8px;
  overflow: hidden;
  flex-shrink: 0;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  background: transparent !important;
  border: 1px solid rgba(139,92,246,0.15);
  box-shadow: none !important;
}
.pico img {
  width: 100% !important; height: 100% !important;
  object-fit: contain !important;
  display: block !important;
  border: none !important; border-radius: 0 !important;
  margin: 0 !important; padding: 0 !important;
}

/* ========== Text area ========== */
.ptxt {
  display: flex !important;
  flex-direction: column !important;
  justify-content: center !important;
  flex: 1;
  min-width: 0;
  align-self: stretch;
}

/* Name — centered */
.pname {
  display: block !important;
  font-size: 12px !important;
  font-weight: 600 !important;
  color: var(--txt) !important;
  text-align: left !important;
  line-height: 1.35;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  margin: 0 !important; padding: 0 !important;
  border: none !important;
  transition: color 0.2s ease;
}
.ptile:hover .pname { color: var(--txt-hover) !important; }

/* Description — hidden by default, slides left→right on hover */
.pdesc {
  display: block !important;
  font-size: 10px !important;
  color: var(--tdesc) !important;
  text-align: left !important;
  line-height: 1.3;
  max-height: 0;
  opacity: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  transform: translateX(-6px);
  transition: all 0.3s ease;
  margin: 0 !important; padding: 0 !important;
  border: none !important;
}
@media (hover: hover) {
  .ptile:hover .pdesc {
    max-height: 28px;
    opacity: 1;
    transform: translateX(0);
  }
}

/* ===================================================
   TOC — Sticky bottom 跟随视口
   =================================================== */
.ptoc-wrap {
  position: sticky;
  bottom: 10px;
  z-index: 100;
  display: flex;
  justify-content: center;
  margin-top: 24px;
  pointer-events: none;
}
.ptoc {
  pointer-events: auto;
  display: flex !important;
  flex-wrap: wrap;
  justify-content: center;
  gap: 5px;
  padding: 7px 10px;
  border-radius: 40px;
  background: var(--toc-bg) !important;
  backdrop-filter: blur(30px) saturate(1.6);
  -webkit-backdrop-filter: blur(30px) saturate(1.6);
  border: 1px solid rgba(255,255,255,0.06) !important;
  box-shadow: 0 4px 20px rgba(0,0,0,0.08);
  max-width: 100%;
  overflow-x: auto;
  scrollbar-width: none;
}
[data-theme="dark"] .ptoc {
  background: var(--toc-bg-dark) !important;
}
.ptoc::-webkit-scrollbar { display: none; }

.ptoc-btn {
  flex-shrink: 0;
  padding: 7px 16px;
  border: none !important;
  border-radius: 30px !important;
  font-size: 13px !important;
  font-weight: 600 !important;
  color: #fff !important;
  background: transparent !important;
  cursor: pointer;
  transition: all 0.2s ease !important;
  white-space: nowrap;
  margin: 0 !important;
  outline: none !important;
  line-height: 1.4;
  position: relative;
}
.ptoc-btn:hover {
  background: rgba(139,92,246,0.10) !important;
}
/* Hover 下划线 — 从左到右发光，与卡片一致 */
.ptoc-btn::after {
  content: '';
  position: absolute;
  bottom: 4px;
  left: 0;
  width: 0;
  height: 2.5px;
  background: linear-gradient(90deg, #a78bfa, #e9d5ff);
  box-shadow: 0 0 12px rgba(167,139,250,0.7), 0 0 28px rgba(167,139,250,0.3);
  transition: width 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  pointer-events: none;
  border-radius: 2px;
}
.ptoc-btn:hover::after {
  width: 100%;
}

/* ===================================================
   Responsive
   =================================================== */
@media (max-width: 860px) {
  .pgrid { gap: 8px !important; }
}
@media (max-width: 600px) {
  .pgrid { gap: 8px !important; }
  .ptile { height: 50px !important; padding: 6px 10px !important; gap: 6px; }
  .pico { width: 24px; height: 24px; }
  .pname { font-size: 11px !important; }
  .ptoc-wrap { bottom: 6px; margin-top: 18px; }
  .ptoc-btn { padding: 5px 12px; font-size: 12px !important; }
  .ptitle { font-size: 14px !important; }
}
@media (max-width: 400px) {
  .pgrid { gap: 6px !important; }
}
@media print {
  .ptoc-wrap { display: none !important; }
  .pnav::before { display: none !important; }
}
</style>

<div class="pnav">
  <div id="pnavContent"></div>
  <div class="ptoc-wrap">
    <div class="ptoc" id="ptocList"></div>
  </div>
</div>

<script>
