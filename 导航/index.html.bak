function renderLinkCards() {
  const container = document.getElementById('link-container');
  const tocList = document.getElementById('custom-toc-list');
  if (!container) return;

  let html = '';
  let tocHtml = '';

  for (const category in linksData) {
    if (!linksData.hasOwnProperty(category)) continue;
    
    const links = linksData[category];
    const categoryId = 'cat-' + category.replace(/\s+/g, '-');

    html += `<h2 id="${categoryId}">${category}</h2>`;
    html += '<div class="link-cards">';
    
    tocHtml += `<li class="custom-toc-item"><a class="custom-toc-link" data-target="${categoryId}">${category}</a></li>`;

    links.forEach(link => {
      html += `
        <a class="card" href="${link.url}" target="_blank">
          <img src="${link.img}" alt="${link.name}" style="${link.style}">
          <div>
            <strong>${link.name}</strong>
            <p>${link.desc}</p>
          </div>
        </a>`;
    });

    html += '</div><hr class="aurora">';
  }

  container.innerHTML = html;
  
  if (tocList) {
    tocList.innerHTML = tocHtml;
    initTocEvents();
  }
}

function initTocEvents() {
  const tocLinks = document.querySelectorAll('.custom-toc-link');
  const headings = document.querySelectorAll('#link-container h2');

  if (!tocLinks.length || !headings.length) return;

  tocLinks.forEach(link => {
    link.addEventListener('click', () => {
      const targetEl = document.getElementById(link.dataset.target);
      if (targetEl) {
        const top = targetEl.getBoundingClientRect().top + window.pageYOffset - 80;
        window.scrollTo({ top, behavior: 'smooth' });
      }
    });
  });

  let ticking = false;
  const updateHighlight = () => {
    let currentId = null;
    for (let i = headings.length - 1; i >= 0; i--) {
      if (headings[i].getBoundingClientRect().top <= 100) {
        currentId = headings[i].id;
        break;
      }
    }
    tocLinks.forEach(link => {
      link.classList.toggle('active', link.dataset.target === currentId);
    });
    ticking = false;
  };

  window.addEventListener('scroll', () => {
    if (!ticking) {
      requestAnimationFrame(updateHighlight);
      ticking = true;
    }
  });

  updateHighlight();
}

// 卡片边缘发光效果
function initCardGlow() {
  const cards = document.querySelectorAll('.card');
  const glowColor = 'rgba(192, 132, 252, 0.8)';

  cards.forEach(card => {
    const baseShadow = '0 20px 50px rgba(0, 0, 0, 0.9)';

    const updateGlow = (e) => {
      const rect = card.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      const w = rect.width;
      const h = rect.height;

      const distTop = y;
      const distBottom = h - y;
      const distLeft = x;
      const distRight = w - x;

      const minDist = Math.min(distTop, distBottom, distLeft, distRight);

      let glowShadow = baseShadow;

      if (minDist === distTop) {
        const offsetX = Math.round((x / w) * 16 - 8);
        glowShadow = `${baseShadow}, ${offsetX}px -10px 20px ${glowColor}`;
      } else if (minDist === distBottom) {
        const offsetX = Math.round((x / w) * 16 - 8);
        glowShadow = `${baseShadow}, ${offsetX}px 10px 20px ${glowColor}`;
      } else if (minDist === distLeft) {
        const offsetY = Math.round((y / h) * 16 - 8);
        glowShadow = `${baseShadow}, -10px ${offsetY}px 20px ${glowColor}`;
      } else {
        const offsetY = Math.round((y / h) * 16 - 8);
        glowShadow = `${baseShadow}, 10px ${offsetY}px 20px ${glowColor}`;
      }

      card.style.boxShadow = glowShadow;
    };

    card.addEventListener('mouseenter', () => {
      card.style.boxShadow = baseShadow;
    });

    card.addEventListener('mousemove', updateGlow);

    card.addEventListener('mouseleave', () => {
      card.style.boxShadow = baseShadow;
    });
  });
}

renderLinkCards();
initCardGlow();
</script>