      {n:"NS211",d:"Switch游戏下载",u:"https://www.ns211.com/",i:"https://www.ns211.com/favicon.ico"},
      {n:"CnGal资料站",d:"Galgame百科资料",u:"https://www.cngal.org/",i:"https://res.cngal.org/_content/CnGalWebSite.Shared/images/logo.png"},
      {n:"MakeMePulse",d:"创意互动体验站",u:"https://2019.makemepulse.com/",i:"https://favicon.im/zh/2019.makemepulse.com?larger=true"}
    ],
    "MC":[
      {n:"LittleSkin",d:"MC皮肤分享平台",u:"https://littleskin.cn/skinlib",i:"https://favicon.im/zh/littleskin.cn?larger=true"},
      {n:"NameMC",d:"国际MC皮肤站",u:"https://namemc.com/minecraft-skins",i:"https://favicon.im/zh/namemc.com?larger=true"},
      {n:"HMCL",d:"MC多功能启动器",u:"https://hmcl.huangyuhui.net/",i:"https://hmcl.huangyuhui.net/favicon.ico"},
      {n:"MapCraft",d:"MC地图存档站",u:"https://zh.mapcraft.me/",i:"https://zh.mapcraft.me/favicon.png"}
    ],
    "站长":[
      {n:"Google站点地图",d:"Google网站地图提交",u:"https://search.google.com/search-console/index",i:"https://favicon.im/zh/search.google.com?larger=true"},
      {n:"Bing站长",d:"Bing网站管理",u:"https://www.bing.com/webmasters",i:"https://favicon.im/zh/www.bing.com?larger=true"}
    ]
  };

  function render() {
    var root = document.getElementById('pnavContent');
    var toc = document.getElementById('ptocList');
    if (!root) return;
    var html = '', tocHtml = '', idx = 0;

    for (var cat in D) {
      var items = D[cat];
      var cid = 'pc-' + cat.replace(/\s+/g, '-');
      html += '<div class="psect">';
      html += '<div class="phead" id="' + cid + '"><h2 class="ptitle">' + cat + '</h2></div>';
      html += '<div class="pgrid">';
      for (var i = 0; i < items.length; i++) {
        var it = items[i];
        var dl = (idx % 18) * 0.035;
        html += '<a class="ptile" href="' + it.u + '" target="_blank" rel="noopener" style="animation-delay:' + dl + 's">';
        html += '<span class="pico"><img src="' + it.i + '" alt="' + it.n + '" loading="lazy"></span>';
        html += '<span class="ptxt">';
        html += '<span class="pname">' + it.n + '</span>';
        html += '<span class="pdesc">' + it.d + '</span>';
        html += '</span></a>';
        idx++;
      }
      html += '</div></div>';
      tocHtml += '<button class="ptoc-btn" data-id="' + cid + '">' + cat + '</button>';
    }
    root.innerHTML = html;
    toc.innerHTML = tocHtml;

    var btns = document.querySelectorAll('.ptoc-btn');
    for (var j = 0; j < btns.length; j++) {
      btns[j].onclick = function() {
        var el = document.getElementById(this.dataset.id);
        if (el) el.scrollIntoView({behavior:'smooth', block:'start'});
      };
    }
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', render);
  else render();
})();
</script>
