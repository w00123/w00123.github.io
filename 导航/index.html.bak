<style>

/* ========= 自定义目录（顶部横向） ========= */
.custom-toc {
  position: fixed;
  top: 60px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 1000;
  background: var(--card-bg, #121212);
  backdrop-filter: blur(12px);
  padding: 8px 16px;
  border-radius: 30px;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
  border: 1px solid rgba(255, 255, 255, 0.1);
}

.custom-toc-title {
  display: none;
}

.custom-toc-list {
  display: flex;
  flex-wrap: nowrap;
  justify-content: center;
  gap: 8px;
  list-style: none;
  padding: 0;
  margin: 0;
}

.custom-toc-item {
  margin: 0;
}

.custom-toc-link {
  display: block;
  font-size: 13px;
  color: #fff !important;
  text-decoration: none !important;
  padding: 7px 12px;
  background: transparent;
  border: none;
  cursor: pointer;
  white-space: nowrap;
  position: relative;
}

.custom-toc-link:visited {
  color: #fff !important;
  text-decoration: none !important;
}

.custom-toc-link:hover {
  text-decoration: none !important;
}

.custom-toc-link::after {
  content: '';
  position: absolute;
  bottom: 4px;
  left: 50%;
  transform: translateX(-50%);
  width: 0;
  height: 2px;
  background: rgba(192, 132, 252, 0.8);
  transition: width 0.3s ease;
}

.custom-toc-link:hover::after {
  width: 100%;
}

.custom-toc-link.active::after {
  width: 100%;
}

/* 移动端适配 */
@media (max-width: 768px) {
  .custom-toc {
    top: 30px;
    padding: 8px 16px;
    max-width: calc(100% - 40px);
  }
  
  .custom-toc-list {
    flex-wrap: nowrap;
    overflow-x: auto;
    justify-content: flex-start;
    gap: 8px;
    padding-bottom: 5px;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  
  .custom-toc-list::-webkit-scrollbar {
    display: none;
  }
  
  .custom-toc-link {
    font-size: 12px;
    padding: 6px 12px;
    flex-shrink: 0;
  }
}

/* ========= 容器 ========= */
#link-container {
  padding-top: 120px;
}

/* 移动端容器适配 */
@media (max-width: 768px) {
  #link-container {
    padding-top: 60px;
  }
  
  .link-cards {
    grid-template-columns: repeat(auto-fill, 100px);
    gap: 10px 1px;
  }
  
  .card {
    max-width: 100px;
    height: 100px;
  }
  
  .card strong {
    font-size: 12px;
  }
  
  .card p {
    font-size: 10px;
  }
}

@media (max-width: 480px) {
  .link-cards {
    grid-template-columns: repeat(auto-fill, 80px);
    gap: 8px 1px;
  }
  
  .card {
    max-width: 80px;
    height: 80px;
  }
  
  .card strong {
    font-size: 10px;
  }
  
  .card p {
    font-size: 8px;
  }
  
  .card > div {
    padding: 6px 8px;
  }
}

.link-cards {
  display: grid;
  grid-template-columns: repeat(auto-fill, 130px);
  gap: 15px 1px;
  justify-content: center;
}

/* ========= 卡片 ========= */
.card {
  flex: 1 1 120px;
  max-width: 120px;
  position: relative;
  height: 120px;
  border-radius: 50%;
  overflow: hidden;
  text-decoration: none;
  color: #fff;
  box-shadow: 0 20px 50px rgba(0, 0, 0, 0.9);
  transition:
    box-shadow .3s ease,
    border-color .3s ease,
    transform .35s cubic-bezier(.25,.8,.25,1);
}

.card img {
  position: absolute;
  inset: 0;
  height: 100%;
  object-fit: cover;
  object-position: center;
  z-index: 0;
  mask-image: linear-gradient(to bottom, rgba(0,0,0,1) 0%, rgba(0,0,0,.3) 100%);
  -webkit-mask-image: linear-gradient(to bottom, rgba(0,0,0,1) 0%, rgba(0,0,0,.3) 100%);
  filter: brightness(.65);
  transition: filter .3s ease, transform .3s ease;
  border-radius: 12px;
}

.card:hover img {
  filter: brightness(.4);
  transform: scale(1.05);
}

.card::after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(to bottom, rgba(0,0,0,.45) 0%, transparent 100%);
  opacity: 0;
  transition: opacity .3s ease;
  z-index: 1;
}

.card:hover::after {
  opacity: 1;
}

.card > div {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 8px 10px;
  z-index: 2;
  color: #fff;
  text-shadow: 0 2px 8px rgba(0,0,0,0.9), 0 1px 2px rgba(0,0,0,1);
  background: linear-gradient(to top, rgba(0,0,0,0.5) 0%, rgba(0,0,0,0.2) 50%, transparent 100%);
}

.card strong {
  display: block;
  font-size: 14px;
  font-weight: 600;
  line-height: 1.3;
}

.card p {
  margin: 0;
  font-size: 12px;
  line-height: 1.4;
  color: rgba(192, 132, 252, 1);
  text-shadow: 0 2px 8px rgba(0,0,0,0.9), 0 0 10px rgba(192, 132, 252, 0.5);
  max-height: 0;
  opacity: 0;
  overflow: hidden;
  transition: all 0.8s cubic-bezier(0.4, 0, 0.2, 1);
}

.card:hover p {
  max-height: 40px;
  opacity: 1;
  margin-top: 2px;
}

hr.aurora {
  border: 0;
  height: 6px;
  margin: 40px auto;
  width: 100%;
  background-image: 
    linear-gradient(to right, 
      #2d145a 6px,
      transparent 2px,
      #783c96 6px,
      transparent 2px);
  background-size: 16px 6px;
  background-repeat: repeat-x;
  background-position: center;
  background-color: transparent;
  image-rendering: pixelated;
  image-rendering: crisp-edges;
}
</style>

